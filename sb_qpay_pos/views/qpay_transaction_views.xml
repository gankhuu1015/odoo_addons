<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sb_qpay_pos_transaction_tree" model="ir.ui.view">
        <field name="name">sb.qpay.pos.transaction.tree</field>
        <field name="model">sb.qpay.pos.transaction</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="external_ref"/>
                <field name="payment_method_id"/>
                <field name="company_id"/>
                <field name="amount"/>
                <field name="state"/>
                <field name="provider_invoice_id"/>
                <field name="line_uuid" optional="hide"/>
                <field name="paid_at" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_sb_qpay_pos_transaction_form" model="ir.ui.view">
        <field name="name">sb.qpay.pos.transaction.form</field>
        <field name="model">sb.qpay.pos.transaction</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="external_ref"/>
                            <field name="idempotency_key"/>
                            <field name="state"/>
                            <field name="payment_method_id"/>
                            <field name="company_id"/>
                            <field name="pos_session_id"/>
                            <field name="pos_config_id"/>
                        </group>
                        <group>
                            <field name="currency_id"/>
                            <field name="amount"/>
                            <field name="provider_invoice_id"/>
                            <field name="order_uuid"/>
                            <field name="line_uuid"/>
                            <field name="paid_at"/>
                        </group>
                    </group>
                    <group>
                        <field name="qr_value" widget="text"/>
                        <field name="last_message" widget="text"/>
                        <field name="callback_payload" widget="json"/>
                        <field name="provider_response" widget="json"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sb_qpay_pos_transaction" model="ir.actions.act_window">
        <field name="name">QPay POS Transactions</field>
        <field name="res_model">sb.qpay.pos.transaction</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_sb_qpay_pos_root" name="QPay POS" parent="point_of_sale.menu_point_config_product" sequence="90" groups="point_of_sale.group_pos_manager"/>
    <menuitem id="menu_sb_qpay_pos_transaction" name="Transactions" parent="menu_sb_qpay_pos_root" action="action_sb_qpay_pos_transaction" groups="point_of_sale.group_pos_manager"/>
</odoo>
